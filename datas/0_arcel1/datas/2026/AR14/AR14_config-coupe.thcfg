encoding  utf-8
input config2.thcfg
input ../../../../../layouts/config3.thcfg
source AR14_tot.th


################################## Selection de la map à exporter #################################
select MC_AR14@AR14-tot      #uncomment ONLY one


export map \
     -projection extended \
     -layout coupe \
     -output exports/AR14_coupe.pdf \

### Stations             # l'ordre des layouts est importants !
#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/AR14_coupe-travail.pdf \

### Debug
#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/AR14_DEBUG_coupe.pdf
