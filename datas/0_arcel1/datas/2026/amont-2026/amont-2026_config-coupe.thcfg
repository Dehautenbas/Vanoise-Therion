encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source amont-2026_tot.th


################################## Selection de la map à exporter #################################
select MC_amont-2026@amont-2026-tot      #uncomment ONLY one


#export map \
     -projection extended \
     -layout coupe \
     -output exports/amont-2026_coupe.pdf \

### Stations             # l'ordre des layouts est importants !
#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/amont-2026_coupe-travail.pdf \

### Debug
#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/amont-2026_DEBUG_coupe.pdf
