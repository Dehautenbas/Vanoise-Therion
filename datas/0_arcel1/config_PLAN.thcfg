encoding  utf-8
input config2.thcfg
input ../../config3.thcfg

source arcel1_tot.th

### Commenter ou décommenter la ligne "bitmap" dans le fichier mnt.th pour drapper l'image sat sur le mnt
### Si problème d'ouverture du 3d avec Loch, commenter la ligne bitmap

source ../surface/mnt-2.th



select MP_arcelin_tot@Arcel1      #uncomment ONLY one

#select MP_murs-et-centerline@Arcel1 #Pour le filaire de la topo pas encore dessinée + la topo déjà dessinée
     #select MP_pas-encore-dessine@Arcel1  #Pour le filaire de la topo pas encore dessinée
     #select MP_juste-une-survey@Arcel1  #Pour le filaire d'une seul séance



### Plan 
export map \
     -projection plan \
     -layout plan \
     -output exports/arcel1_plan.pdf 

### Stations
export map \
     -projection plan \
     -layout plan \
     -layout centerline \
     -output exports/arcel1_plan-travail.pdf 

### 3d
export model \
     -format loch \
     -o exports/arcelin.lox \
     #-wall-source maps
     

### Surface
export map \
     -projection plan \
     -layout plan-surface \
     -output exports/arcel1_plan-surface.pdf

### DEBUG
#export map \
     -projection plan \
     -layout plan   \
     -layout debug \
     -output exports/arcel1_DEBUG_plan.pdf
     
######################### SVG ########################
#export map \
     -projection plan \
     -fmt svg   \
     -layout plan   \
     -output exports/arcel1_plan.svg \

#export map \
     -projection extended \
     -layout plan   \
     -output exports/arcel1_coupe.svg \

#export model \
     -output exports/arcel1_coupe.dxf \



